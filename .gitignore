# Colcon 构建产物（仅在 sealien_ws 根目录 build，勿在 git 仓库根目录 colcon build）
build/
install/
log/

# 包名重命名后本地残留的空壳目录（仅 __pycache__ 等，勿提交）
src/orion_*/

# Python
__pycache__/
.pytest_cache/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
*.egg

# IDE / 编辑器
.idea/
.vscode/


# 本地安装包（可选，若需提交请删除此行）
*.deb

# arm_bag_tools 默认录制（保留 bags/.gitkeep）
tools/arm_bag_tools/bags/*
!tools/arm_bag_tools/bags/.gitkeep

# 本地填写的 job 元数据（模板见 jobs.jsonl.example）
tools/arm_bag_tools/jobs.jsonl

# arm_bag_tools 一键分析输出（保留 analysis/.gitkeep）
tools/arm_bag_tools/analysis/*
!tools/arm_bag_tools/analysis/.gitkeep

# arm_bag_tools 交付打包产物
tools/arm_bag_tools/delivery/

# 系统与临时
.DS_Store
*.log

# Web 前端：Three.js 等（见 web/package.json，首次在 web/ 下 npm install）
web/node_modules/
